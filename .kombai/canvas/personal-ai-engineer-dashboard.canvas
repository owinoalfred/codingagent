        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap');\n  .font-work { font-family: 'Work Sans', sans-serif; }\n  .font-alegreya { font-family: 'Alegreya Sans SC', sans-serif; }\n  .font-technical { font-family: 'Iosevka', 'SFMono-Regular', 'Cascadia Code', 'Roboto Mono', Consolas, monospace; font-variant-numeric: tabular-nums; }\n  .run-slip { clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%); }\n  .run-slip:hover { background: #2A2723; }\n  .record-selected { box-shadow: inset 0 2px 0 #D8C18E; }\n  .focusable:focus-visible { outline: 2px solid #D8C18E; outline-offset: 3px; }\n  .trail-line { position: absolute; left: 31px; top: 38px; bottom: 16px; width: 1px; background: #4B4640; }\n  .status-square { width: 9px; height: 9px; display: inline-block; flex: 0 0 auto; }\n  .status-square-lg { width: 11px; height: 11px; display: inline-block; flex: 0 0 auto; }\n  .status-square-brass { border: 1px solid #D8C18E; background: #171616; box-shadow: inset 0 0 0 2px #171616; }\n  .status-square-copper { background: #D18A4B; }\n  .status-square-blue { background: #7394B5; }\n  .status-square-green { background: #6EAA87; }\n  .status-square-garnet { background: #BE625C; }\n  .status-square-muted { border: 1px solid #B9B0A5; background: transparent; }\n  .archive-row:hover { background: #211F1D; }\n  .archive-row td { border-top: 1px solid #4B4640; }\n  .table-scroll { overflow-x: auto; }\n  @media (max-width: 1050px) {\n    .dashboard-grid { grid-template-columns: minmax(0, 1fr) !important; }\n    .trail-panel { order: -1; }\n    .usage-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }\n  }\n  @media (max-width: 640px) {\n    .page-shell { padding-left: 18px !important; padding-right: 18px !important; }\n    .masthead { flex-direction: column; align-items: flex-start !important; gap: 18px; }\n    .health-line { white-space: normal !important; line-height: 1.6; }\n    .usage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }\n    .usage-item:nth-child(3), .usage-item:nth-child(6) { border-right: 0 !important; }\n    .archive-table { min-width: 700px; }\n    .trail-meta { align-items: flex-start !important; flex-direction: column; gap: 8px; }\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"page-shell m-0 min-h-screen bg-[#171616] px-10 py-8 text-[#F1ECE3] font-work antialiased\" data-kid=\"2\" data-name=\"Page shell container\">\n    <header class=\"masthead flex items-end justify-between border-b border-[#4B4640] pb-6\" data-kid=\"2-1\" data-name=\"Header masthead\">\n        <div data-kid=\"2-1-1\" data-name=\"Header identity group\">\n            <div class=\"mb-3 flex items-center gap-3 text-[11px] font-semibold tracking-[0.18em] text-[#B9B0A5] font-alegreya\" data-kid=\"2-1-1-1\" data-name=\"Header status label\">\n                <span class=\"inline-block h-2 w-2 bg-[#D8C18E]\" data-kid=\"2-1-1-1-1\" data-name=\"Status indicator square\">\n                </span>\n                SELF-HOSTED CONTROL PLANE\n            </div>\n            <h1 class=\"m-0 text-[31px] font-semibold leading-none tracking-[-0.035em] text-[#F1ECE3]\" data-kid=\"2-1-1-2\" data-name=\"Main page heading\">\n                Personal AI Engineer\n            </h1>\n            <p class=\"m-0 mt-3 text-[13px] text-[#B9B0A5]\" data-kid=\"2-1-1-3\" data-name=\"System run info\">\n                Run docket · operator view\n            </p>\n        </div>\n        <div class=\"max-w-[620px] text-right\" data-kid=\"2-1-2\" data-name=\"Header health and status panel\">\n            <div class=\"health-line flex items-center justify-end gap-2 whitespace-nowrap text-[13px] text-[#F1ECE3]\" data-kid=\"2-1-2-1\" data-name=\"Health status line\">\n                <span class=\"inline-block h-2 w-2 bg-[#6EAA87]\" data-kid=\"2-1-2-1-1\" data-name=\"Gateway health status square\">\n                </span>\n                <span data-kid=\"2-1-2-1-2\" data-name=\"Gateway health label\">\n                    Gateway reachable\n                </span>\n                <span class=\"text-[#4B4640]\" data-kid=\"2-1-2-1-3\" data-name=\"Separator bullet\">\n                    ·\n                </span>\n                <span class=\"inline-block h-2 w-2 bg-[#6EAA87]\" data-kid=\"2-1-2-1-4\" data-name=\"Model health status square\">\n                </span>\n                <span data-kid=\"2-1-2-1-5\" data-name=\"Model health label\">\n                    Model reachable\n                </span>\n                <span class=\"text-[#4B4640]\" data-kid=\"2-1-2-1-6\" data-name=\"Separator bullet\">\n                    ·\n                </span>\n                <span class=\"inline-block h-2 w-2 bg-[#D18A4B]\" data-kid=\"2-1-2-1-7\" data-name=\"Approval health status square\">\n                </span>\n                <span data-kid=\"2-1-2-1-8\" data-name=\"Approval health label\">\n                    1 approval held\n                </span>\n                <span class=\"text-[#4B4640]\" data-kid=\"2-1-2-1-9\" data-name=\"Separator bullet\">\n                    ·\n                </span>\n                <span class=\"inline-block h-2 w-2 bg-[#7394B5]\" data-kid=\"2-1-2-1-10\" data-name=\"Execution health status square\">\n                </span>\n                <span data-kid=\"2-1-2-1-11\" data-name=\"Execution health label\">\n                    1 task in execution\n                </span>\n            </div>\n            <div class=\"mt-3 flex items-center justify-end gap-2 text-[11px] text-[#B9B0A5] font-technical\" data-kid=\"2-1-2-2\" data-name=\"Refresh timestamp info\">\n                <i aria-hidden=\"true\" class=\"ti ti-refresh text-[13px]\" data-kid=\"2-1-2-2-1\" data-name=\"Refresh icon\">\n                </i>\n                <span data-dynamic=\"true\" data-kid=\"2-1-2-2-2\" data-name=\"Last checked timestamp\" data-reason=\"Timestamp string replaced by real-time sync script\">\n                    checked 12:04:18 UTC\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"dashboard-grid mt-8 grid grid-cols-[minmax(420px,0.86fr)_minmax(620px,1.14fr)] items-start gap-8\" data-kid=\"2-2\" data-name=\"Dashboard grid container\">\n        <section aria-labelledby=\"docket-heading\" data-kid=\"2-2-1\" data-name=\"Open docket section\">\n            <div class=\"mb-4 flex items-end justify-between border-b border-[#4B4640] pb-3\" data-kid=\"2-2-1-1\" data-name=\"Docket header group\">\n                <div data-kid=\"2-2-1-1-1\" data-name=\"Docket title group\">\n                    <div class=\"mb-2 text-[11px] font-semibold tracking-[0.18em] text-[#B9B0A5] font-alegreya\" data-kid=\"2-2-1-1-1-1\" data-name=\"Docket section label\">\n                        01 / OPEN DOCKET\n                    </div>\n                    <h2 class=\"m-0 text-[21px] font-semibold tracking-[-0.025em] text-[#F1ECE3]\" data-kid=\"2-2-1-1-1-2\" data-name=\"Docket section heading\" id=\"docket-heading\">\n                        Open work\n                    </h2>\n                </div>\n                <div class=\"text-right text-[11px] leading-5 text-[#B9B0A5] font-technical\" data-kid=\"2-2-1-1-2\" data-name=\"Docket summary group\">\n                    <div class=\"text-[#D8C18E]\" data-kid=\"2-2-1-1-2-1\" data-name=\"Docket record count\">\n                        3 records\n                    </div>\n                    <div data-kid=\"2-2-1-1-2-2\" data-name=\"Docket sort description\">\n                        ordered by action\n                    </div>\n                </div>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"2-2-1-2\" data-name=\"Docket record list\">\n                <article aria-label=\"Approval held: Refactor approval flow\" class=\"run-slip record-selected focusable relative border border-[#4B4640] bg-[#211F1D] p-5\" data-kid=\"2-2-1-2-1\" data-name=\"Approval held record card\" tabindex=\"0\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-1-2-1-1\" data-name=\"Record status header\">\n                        <div class=\"flex items-center gap-2 text-[11px] font-semibold tracking-[0.11em] text-[#D18A4B] font-alegreya\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"Record status label group\">\n                            <span class=\"status-square status-square-copper\" data-kid=\"2-2-1-2-1-1-1-1\" data-name=\"Status indicator square\">\n                            </span>\n                            HELD FOR APPROVAL\n                        </div>\n                        <span class=\"text-[11px] text-[#B9B0A5] font-technical\" data-kid=\"2-2-1-2-1-1-2\" data-name=\"Record timestamp\">\n                            12m ago\n                        </span>\n                    </div>\n                    <h3 class=\"m-0 mt-4 text-[19px] font-semibold leading-tight text-[#F1ECE3]\" data-kid=\"2-2-1-2-1-2\" data-name=\"Record title heading\">\n                        Refactor approval flow\n                    </h3>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-1-3\" data-name=\"Record agent info\">\n                        <span class=\"font-technical text-[#D8C18E]\" data-kid=\"2-2-1-2-1-3-1\" data-name=\"Agent name tag\">\n                            Coder\n                        </span>\n                        <span class=\"text-[#4B4640]\" data-kid=\"2-2-1-2-1-3-2\" data-name=\"Separator bullet\">\n                            ·\n                        </span>\n                        <span data-kid=\"2-2-1-2-1-3-3\" data-name=\"Agent status text\">\n                            waiting on human decision\n                        </span>\n                    </div>\n                    <div class=\"mt-5 border-t border-[#4B4640] pt-4\" data-kid=\"2-2-1-2-1-4\" data-name=\"Record action info container\">\n                        <div class=\"flex items-center justify-between gap-3 text-[11px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-1-4-1\" data-name=\"Requested action label group\">\n                            <span class=\"uppercase tracking-[0.14em] font-alegreya\" data-kid=\"2-2-1-2-1-4-1-1\" data-name=\"Requested action label\">\n                                Requested action\n                            </span>\n                            <span class=\"font-technical text-[#F1ECE3]\" data-kid=\"2-2-1-2-1-4-1-2\" data-name=\"Requested action name\">\n                                write_file\n                            </span>\n                        </div>\n                        <div class=\"mt-2 truncate text-[12px] text-[#B9B0A5] font-technical\" data-kid=\"2-2-1-2-1-4-2\" data-name=\"Target filename\">\n                            agent-api/app.py\n                        </div>\n                    </div>\n                    <div class=\"mt-5 flex items-center gap-4\" data-kid=\"2-2-1-2-1-5\" data-name=\"Action buttons group\">\n                        <button class=\"focusable bg-[#D18A4B] px-4 py-2 text-[12px] font-semibold text-[#171616] hover:bg-[#D8A15E]\" data-kid=\"2-2-1-2-1-5-1\" data-name=\"Approve button\" type=\"button\">\n                            Approve action\n                        </button>\n                        <button class=\"focusable border-b border-[#BE625C] pb-1 text-[12px] font-medium text-[#BE625C] hover:text-[#F1ECE3]\" data-kid=\"2-2-1-2-1-5-2\" data-name=\"Reject button\" type=\"button\">\n                            Reject action\n                        </button>\n                    </div>\n                </article>\n                <article aria-label=\"In execution: Improve model routing\" class=\"run-slip focusable relative border border-[#4B4640] bg-[#211F1D] p-5\" data-kid=\"2-2-1-2-2\" data-name=\"In execution record card\" tabindex=\"0\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-1-2-2-1\" data-name=\"Record status header\">\n                        <div class=\"flex items-center gap-2 text-[11px] font-semibold tracking-[0.11em] text-[#7394B5] font-alegreya\" data-kid=\"2-2-1-2-2-1-1\" data-name=\"Record status label group\">\n                            <span class=\"status-square status-square-blue\" data-kid=\"2-2-1-2-2-1-1-1\" data-name=\"Status indicator square\">\n                            </span>\n                            IN EXECUTION\n                        </div>\n                        <span class=\"text-[11px] text-[#B9B0A5] font-technical\" data-kid=\"2-2-1-2-2-1-2\" data-name=\"Record timestamp\">\n                            28m ago\n                        </span>\n                    </div>\n                    <h3 class=\"m-0 mt-4 text-[19px] font-semibold leading-tight text-[#F1ECE3]\" data-kid=\"2-2-1-2-2-2\" data-name=\"Record title heading\">\n                        Improve model routing\n                    </h3>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-2-3\" data-name=\"Record agent info\">\n                        <span class=\"font-technical text-[#7394B5]\" data-kid=\"2-2-1-2-2-3-1\" data-name=\"Agent name tag\">\n                            Tester\n                        </span>\n                        <span class=\"text-[#4B4640]\" data-kid=\"2-2-1-2-2-3-2\" data-name=\"Separator bullet\">\n                            ·\n                        </span>\n                        <span data-kid=\"2-2-1-2-2-3-3\" data-name=\"Agent status text\">\n                            running verification suite\n                        </span>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#4B4640] pt-4 text-[11px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-2-4\" data-name=\"Record execution footer\">\n                        <span class=\"font-technical\" data-kid=\"2-2-1-2-2-4-1\" data-name=\"Task ID text\">\n                            task-a42bf123\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"2-2-1-2-2-4-2\" data-name=\"Sandbox status indicator\">\n                            <i aria-hidden=\"true\" class=\"ti ti-terminal-2 text-[14px]\" data-kid=\"2-2-1-2-2-4-2-1\" data-name=\"Sandbox icon\">\n                            </i>\n                            sandbox observed\n                        </span>\n                    </div>\n                </article>\n                <article aria-label=\"Requires review: Harden approval handling\" class=\"run-slip focusable relative border border-[#4B4640] bg-[#211F1D] p-5\" data-kid=\"2-2-1-2-3\" data-name=\"Requires review record card\" tabindex=\"0\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-1-2-3-1\" data-name=\"Record status header\">\n                        <div class=\"flex items-center gap-2 text-[11px] font-semibold tracking-[0.11em] text-[#BE625C] font-alegreya\" data-kid=\"2-2-1-2-3-1-1\" data-name=\"Record status label group\">\n                            <span class=\"status-square status-square-garnet\" data-kid=\"2-2-1-2-3-1-1-1\" data-name=\"Status indicator square\">\n                            </span>\n                            REQUIRES REVIEW\n                        </div>\n                        <span class=\"text-[11px] text-[#B9B0A5] font-technical\" data-kid=\"2-2-1-2-3-1-2\" data-name=\"Record timestamp\">\n                            1h ago\n                        </span>\n                    </div>\n                    <h3 class=\"m-0 mt-4 text-[19px] font-semibold leading-tight text-[#F1ECE3]\" data-kid=\"2-2-1-2-3-2\" data-name=\"Record title heading\">\n                        Harden approval handling\n                    </h3>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-3-3\" data-name=\"Record agent info\">\n                        <span class=\"font-technical text-[#BE625C]\" data-kid=\"2-2-1-2-3-3-1\" data-name=\"Agent name tag\">\n                            Security\n                        </span>\n                        <span class=\"text-[#4B4640]\" data-kid=\"2-2-1-2-3-3-2\" data-name=\"Separator bullet\">\n                            ·\n                        </span>\n                        <span data-kid=\"2-2-1-2-3-3-3\" data-name=\"Agent status text\">\n                            review required before merge\n                        </span>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t border-[#4B4640] pt-4 text-[11px] text-[#B9B0A5]\" data-kid=\"2-2-1-2-3-4\" data-name=\"Record execution footer\">\n                        <span class=\"font-technical\" data-kid=\"2-2-1-2-3-4-1\" data-name=\"Task ID text\">\n                            task-8d0e4a2c\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"2-2-1-2-3-4-2\" data-name=\"Security flag indicator\">\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-search text-[14px]\" data-kid=\"2-2-1-2-3-4-2-1\" data-name=\"Security icon\">\n                            </i>\n                            security flag\n                        </span>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mt-5 border border-dashed border-[#4B4640] px-5 py-4\" data-kid=\"2-2-1-3\" data-name=\"Docket empty state placeholder\">\n                <div class=\"flex items-center gap-2 text-[11px] font-semibold tracking-[0.14em] text-[#B9B0A5] font-alegreya\" data-kid=\"2-2-1-3-1\" data-name=\"Empty docket status label\">\n                    <span class=\"status-square status-square-muted\" data-kid=\"2-2-1-3-1-1\" data-name=\"Status indicator square\">\n                    </span>\n                    NO OPEN WORK\n                </div>\n                <p class=\"m-0 mt-2 text-[12px] leading-5 text-[#B9B0A5]\" data-kid=\"2-2-1-3-2\" data-name=\"Empty docket description text\">\n                    When the docket clears, task history remains in the archive below.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"trail-heading\" class=\"trail-panel\" data-kid=\"2-2-2\" data-name=\"Execution trail section\">\n            <div class=\"mb-4 flex items-end justify-between border-b border-[#4B4640] pb-3\" data-kid=\"2-2-2-1\" data-name=\"Execution trail header group\">\n                <div data-kid=\"2-2-2-1-1\" data-name=\"Trail title group\">\n                    <div class=\"mb-2 text-[11px] font-semibold tracking-[0.18em] text-[#B9B0A5] font-alegreya\" data-kid=\"2-2-2-1-1-1\" data-name=\"Trail section label\">\n                        02 / SELECTED RECORD\n                    </div>\n                    <h2 class=\"m-0 text-[21px] font-semibold tracking-[-0.025em] text-[#F1ECE3]\" data-kid=\"2-2-2-1-1-2\" data-name=\"Trail section heading\" id=\"trail-heading\">\n                        Execution trail\n                    </h2>\n                </div>\n                <div class=\"text-right\" data-kid=\"2-2-2-1-2\" data-name=\"Trail status summary group\">\n                    <div class=\"flex items-center justify-end gap-2 text-[12px] text-[#D18A4B]\" data-kid=\"2-2-2-1-2-1\" data-name=\"Current trail status label\">\n                        <span class=\"status-square status-square-copper\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"Status indicator square\">\n                        </span>\n                        Held for approval\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#B9B0A5] font-technical\" data-kid=\"2-2-2-1-2-2\" data-name=\"Task ID text\">\n                        task-f9a2c7d1\n                    </div>\n                </div>\n            </div>\n            <div class=\"border border-[#4B4640] bg-[#211F1D]\" data-kid=\"2-2-2-2\" data-name=\"Trail content panel\">\n                <div class=\"trail-meta flex items-center justify-between border-b border-[#4B4640] px-6 py-5\" data-kid=\"2-2-2-2-1\" data-name=\"Trail meta header\">\n                    <div data-kid=\"2-2-2-2-1-1\" data-name=\"Trail task title group\">\n                        <h3 class=\"m-0 text-[24px] font-semibold tracking-[-0.035em] text-[#F1ECE3]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"Record title heading\">\n                            Refactor approval flow\n                        </h3>\n                        <p class=\"m-0 mt-2 text-[12px] text-[#B9B0A5]\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"Task lifecycle metadata\">\n                            Planner → Coder → Tester · created 12:03 UTC\n                        </p>\n                    </div>\n                    <div class=\"text-right text-[12px] text-[#B9B0A5]\" data-kid=\"2-2-2-2-1-2\" data-name=\"Task spend summary group\">\n                        <div class=\"font-technical text-[#D8C18E]\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"Task spend amount\">\n                            US$0.42 / US$2.00\n                        </div>\n                        <div class=\"mt-1\" data-kid=\"2-2-2-2-1-2-2\" data-name=\"Task spend label\">\n                            task spend / ceiling\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative px-6 py-5\" data-kid=\"2-2-2-2-2\" data-name=\"Trail timeline container\">\n                    <div aria-hidden=\"true\" class=\"trail-line\" data-kid=\"2-2-2-2-2-1\" data-name=\"Timeline vertical guide line\">\n                    </div>\n                    <ol class=\"m-0 list-none space-y-4 p-0\"