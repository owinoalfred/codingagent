    },
    "var_16d3d1f2aac9": {
      "type": "variant",
      "label": "Sentinel Board Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&family=Commit+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.sentinel-board {\n  --canvas: #12141B;\n  --surface: #1C2029;\n  --surface-raised: #242A35;\n  --rule: #3A4350;\n  --ink: #E7E9E5;\n  --muted: #9EA8B5;\n  --quiet: #76818E;\n  --healthy: #78B39A;\n  --running: #6E9ED6;\n  --amber: #D89A48;\n  --danger: #CA655D;\n  --alloy: #C4CCD3;\n  --focus: #C4CCD3;\n  font-family: 'Atkinson Hyperlegible Next', system-ui, sans-serif;\n  background: var(--canvas);\n  color: var(--ink);\n}\n.sentinel-board .mono { font-family: 'Commit Mono', ui-monospace, monospace; }\n.sentinel-board .eyebrow { letter-spacing: .12em; text-transform: uppercase; font-size: 11px; line-height: 1.2; color: var(--muted); }\n.sentinel-board .conduit { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; }\n.sentinel-board .station { position: relative; min-height: 136px; padding: 0 18px 0 0; }\n.sentinel-board .station::after { content: ''; position: absolute; z-index: 0; top: 17px; left: 31px; width: calc(100% - 27px); border-top: 1px solid var(--rule); }\n.sentinel-board .station.bridge-amber::after { border-top: 1px dashed var(--amber); }\n.sentinel-board .station:last-child::after { display: none; }\n.sentinel-board .station-content { position: relative; z-index: 1; background: var(--canvas); padding-right: 12px; width: fit-content; max-width: 100%; }\n.sentinel-board .station-mark { width: 11px; height: 11px; display: inline-block; border: 1px solid currentColor; border-radius: 2px; flex: 0 0 auto; }\n.sentinel-board .station-mark.healthy { background: var(--healthy); color: var(--healthy); border-color: var(--healthy); }\n.sentinel-board .station-mark.running { background: var(--running); color: var(--running); border-color: var(--running); }\n.sentinel-board .station-mark.waiting { background: var(--amber); color: var(--amber); border-color: var(--amber); }\n.sentinel-board .station-mark.none { background: transparent; color: var(--quiet); border-color: var(--quiet); }\n.sentinel-board .station-mark.unavailable { background: var(--danger); color: var(--danger); border-color: var(--danger); }\n.sentinel-board .queue-row { min-height: 72px; transition: background-color 140ms ease, border-color 140ms ease; }\n.sentinel-board .queue-row:hover { background: var(--surface); }\n.sentinel-board .queue-row:focus-within { outline: 2px solid var(--focus); outline-offset: -2px; }\n.sentinel-board .approval-panel { background: var(--surface-raised); }\n.sentinel-board .approval-panel button { transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease; }\n.sentinel-board .approval-panel button:focus-visible,\n.sentinel-board .queue-row button:focus-visible,\n.sentinel-board summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }\n.sentinel-board .approval-panel .approve:hover { background: #e2a858; color: var(--canvas); }\n.sentinel-board .approval-panel .reject:hover { border-color: var(--danger); color: #E7B1AB; background: rgba(202,101,93,.08); }\n.sentinel-board .accounting-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }\n.sentinel-board .accounting-cell { min-height: 84px; border-right: 1px solid var(--rule); padding: 13px 18px 12px 0; margin-right: 18px; }\n.sentinel-board .accounting-cell:last-child { border-right: 0; margin-right: 0; }\n.sentinel-board .ledger tbody tr { transition: background-color 140ms ease; }\n.sentinel-board .ledger tbody tr:hover { background: rgba(196,204,211,.045); }\n.sentinel-board .ledger tbody td { border-top: 1px solid rgba(58,67,80,.75); }\n.sentinel-board .table-wrap { overflow-x: auto; }\n@media (max-width: 1080px) {\n  .sentinel-board .conduit { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 22px; }\n  .sentinel-board .station:nth-child(3)::after { display: none; }\n  .sentinel-board .station:nth-child(4)::after { display: block; }\n  .sentinel-board .control-grid { grid-template-columns: 1fr; }\n  .sentinel-board .approval-panel { margin-top: 2px; }\n}\n@media (max-width: 650px) {\n  .sentinel-board .conduit { grid-template-columns: 1fr; row-gap: 0; }\n  .sentinel-board .station { min-height: 88px; padding: 0; }\n  .sentinel-board .station::after { top: 28px; left: 5px; width: 1px; height: 60px; border-top: 0; border-left: 1px solid var(--rule); }\n  .sentinel-board .station.bridge-amber::after { border-top: 0; border-left: 1px dashed var(--amber); }\n  .sentinel-board .station:nth-child(3)::after { display: block; }\n  .sentinel-board .station:last-child::after { display: none; }\n  .sentinel-board .accounting-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .sentinel-board .accounting-cell:nth-child(2n) { border-right: 0; margin-right: 0; }\n  .sentinel-board .accounting-cell:nth-child(n+3) { border-top: 1px solid var(--rule); padding-top: 14px; }\n  .sentinel-board .masthead { align-items: flex-start; flex-direction: column; gap: 12px; }\n}\n</style>\n<div class=\"sentinel-board min-h-screen\" data-kid=\"1\" data-name=\"sentinel board dashboard\">\n    <main class=\"mx-auto max-w-[1500px] px-6 py-6 lg:px-8\" data-kid=\"1-1\" data-name=\"main content wrapper\">\n        <header class=\"masthead flex items-end justify-between gap-8 border-b border-[var(--rule)] pb-4\" data-kid=\"1-1-1\" data-name=\"page header section\">\n            <div data-kid=\"1-1-1-1\" data-name=\"header title group\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1-1\" data-name=\"status indicator group\">\n                    <span aria-hidden=\"true\" class=\"h-2 w-2 bg-[var(--healthy)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"system status indicator\">\n                    </span>\n                    <p class=\"eyebrow\" data-kid=\"1-1-1-1-1-2\" data-name=\"eyebrow label\">\n                        Self-hosted control plane\n                    </p>\n                </div>\n                <h1 class=\"mt-2 text-[28px] font-semibold tracking-[-0.025em] text-[var(--ink)]\" data-kid=\"1-1-1-1-2\" data-name=\"main page title\">\n                    Personal AI Engineer\n                </h1>\n                <p class=\"mt-1 text-sm text-[var(--muted)]\" data-kid=\"1-1-1-1-3\" data-name=\"operator description\">\n                    Operator view\n                    <span class=\"px-1 text-[var(--quiet)]\" data-kid=\"1-1-1-1-3-1\" data-name=\"bullet point separator\">\n                        ·\n                    </span>\n                    gateway, agents, approvals, and model usage\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-end gap-x-6 gap-y-2 text-right text-xs text-[var(--muted)]\" data-kid=\"1-1-1-2\" data-name=\"header status panel\">\n                <div data-kid=\"1-1-1-2-1\" data-name=\"data freshness status group\">\n                    <p class=\"eyebrow\" data-kid=\"1-1-1-2-1-1\" data-name=\"status label\">\n                        Data freshness\n                    </p>\n                    <p class=\"mono mt-1 text-[var(--alloy)]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2\" data-name=\"last checked timestamp\" data-reason=\"text reinitialized on page load/refresh\">\n                        checked 12:41:03 UTC\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2 border-l border-[var(--rule)] pl-5\" data-kid=\"1-1-1-2-2\" data-name=\"local history status group\">\n                    <span aria-hidden=\"true\" class=\"station-mark healthy\" data-kid=\"1-1-1-2-2-1\" data-name=\"status mark icon\">\n                    </span>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"status label text\">\n                        Local history available\n                    </span>\n                </div>\n            </div>\n        </header>\n        <p class=\"mt-4 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-1-2\" data-name=\"quick summary status row\">\n            <span class=\"text-[var(--healthy)]\" data-kid=\"1-1-2-1\" data-name=\"gateway status text\">\n                Gateway reachable\n            </span>\n            <span class=\"px-2 text-[var(--quiet)]\" data-kid=\"1-1-2-2\" data-name=\"separator\">\n                ·\n            </span>\n            <span class=\"text-[var(--healthy)]\" data-kid=\"1-1-2-3\" data-name=\"model status text\">\n                Model reachable\n            </span>\n            <span class=\"px-2 text-[var(--quiet)]\" data-kid=\"1-1-2-4\" data-name=\"separator\">\n                ·\n            </span>\n            <span class=\"text-[var(--amber)]\" data-kid=\"1-1-2-5\" data-name=\"approval status text\">\n                1 approval held\n            </span>\n            <span class=\"px-2 text-[var(--quiet)]\" data-kid=\"1-1-2-6\" data-name=\"separator\">\n                ·\n            </span>\n            <span class=\"text-[var(--running)]\" data-kid=\"1-1-2-7\" data-name=\"execution status text\">\n                1 task in execution\n            </span>\n        </p>\n        <section aria-labelledby=\"system-path-title\" class=\"mt-6 border-y border-[var(--rule)] py-5\" data-kid=\"1-1-3\" data-name=\"system path visualization\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-1-3-1\" data-name=\"visualization header\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"title group\">\n                    <div class=\"flex items-center gap-2 text-[var(--alloy)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"icon label group\">\n                        <i aria-hidden=\"true\" class=\"ti ti-route text-[15px]\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"route icon\" style=\"width:15px;height:15px;color:var(--alloy);display:inline-block\">\n                        </i>\n                        <h2 class=\"text-[18px] font-semibold\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"section title\" id=\"system-path-title\">\n                            System path\n                        </h2>\n                    </div>\n                    <p class=\"mt-1 max-w-2xl text-xs leading-5 text-[var(--muted)]\" data-kid=\"1-1-3-1-1-2\" data-name=\"section description\">\n                        Observed states are backed by a health check or a recorded run. No record is not the same as an outage.\n                    </p>\n                </div>\n                <div class=\"mono flex flex-wrap gap-x-4 gap-y-1 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-1-2\" data-name=\"legend group\">\n                    <span data-kid=\"1-1-3-1-2-1\" data-name=\"observed status legend\">\n                        <span aria-hidden=\"true\" class=\"station-mark healthy mr-1 align-[-1px]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"status mark\">\n                        </span>\n                        Observed\n                    </span>\n                    <span data-kid=\"1-1-3-1-2-2\" data-name=\"not observed status legend\">\n                        <span aria-hidden=\"true\" class=\"station-mark none mr-1 align-[-1px]\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"status mark\">\n                        </span>\n                        Not observed\n                    </span>\n                    <span data-kid=\"1-1-3-1-2-3\" data-name=\"unavailable status legend\">\n                        <span aria-hidden=\"true\" class=\"station-mark unavailable mr-1 align-[-1px]\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"status mark\">\n                        </span>\n                        Unavailable\n                    </span>\n                </div>\n            </div>\n            <div aria-label=\"Gateway to security review evidence path\" class=\"conduit mt-6\" data-kid=\"1-1-3-2\" data-name=\"system path grid\">\n                <div class=\"station bridge-amber\" data-kid=\"1-1-3-2-1\" data-name=\"gateway station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-1-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark healthy\" data-kid=\"1-1-3-2-1-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-server-2 text-[14px]\" data-kid=\"1-1-3-2-1-1-1-2\" data-name=\"server icon\" style=\"width:14px;height:14px;color:var(--alloy);display:inline-block\">\n                            </i>\n                            Gateway\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--healthy)]\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"station status label\">\n                            Observed\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-1-1-3\" data-name=\"station details text\">\n                            HTTP 200 response\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-1-1-4\" data-name=\"station timestamp\">\n                            12:41:03 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"station bridge-amber\" data-kid=\"1-1-3-2-2\" data-name=\"model station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-2-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark healthy\" data-kid=\"1-1-3-2-2-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-cpu text-[14px]\" data-kid=\"1-1-3-2-2-1-1-2\" data-name=\"cpu icon\" style=\"width:14px;height:14px;color:var(--alloy);display:inline-block\">\n                            </i>\n                            Model\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--healthy)]\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"station status label\">\n                            Observed\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-2-1-3\" data-name=\"station details text\">\n                            qwen3-coder-next\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-2-1-4\" data-name=\"station timestamp\">\n                            12:41:03 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"station\" data-kid=\"1-1-3-2-3\" data-name=\"execution station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-3-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark waiting\" data-kid=\"1-1-3-2-3-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-player-pause text-[14px]\" data-kid=\"1-1-3-2-3-1-1-2\" data-name=\"pause icon\" style=\"width:14px;height:14px;color:var(--amber);display:inline-block\">\n                            </i>\n                            Execution\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--amber)]\" data-kid=\"1-1-3-2-3-1-2\" data-name=\"station status label\">\n                            Interrupted\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-3-1-3\" data-name=\"station details text\">\n                            write_file held for review\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-3-1-4\" data-name=\"station timestamp\">\n                            12:40:22 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"station\" data-kid=\"1-1-3-2-4\" data-name=\"sandbox station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-4-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-4-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark none\" data-kid=\"1-1-3-2-4-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-box text-[14px]\" data-kid=\"1-1-3-2-4-1-1-2\" data-name=\"box icon\" style=\"width:14px;height:14px;color:var(--quiet);display:inline-block\">\n                            </i>\n                            Sandbox\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--muted)]\" data-kid=\"1-1-3-2-4-1-2\" data-name=\"station status label\">\n                            Not observed\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-4-1-3\" data-name=\"station details text\">\n                            No sandbox record in this run\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-4-1-4\" data-name=\"station timestamp\">\n                            —\n                        </p>\n                    </div>\n                </div>\n                <div class=\"station\" data-kid=\"1-1-3-2-5\" data-name=\"worktree station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-5-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-5-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark healthy\" data-kid=\"1-1-3-2-5-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-git-branch text-[14px]\" data-kid=\"1-1-3-2-5-1-1-2\" data-name=\"git branch icon\" style=\"width:14px;height:14px;color:var(--alloy);display:inline-block\">\n                            </i>\n                            Worktree\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--healthy)]\" data-kid=\"1-1-3-2-5-1-2\" data-name=\"station status label\">\n                            Observed\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-5-1-3\" data-name=\"station details text\">\n                            task-8d0e4a2c ready\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-5-1-4\" data-name=\"station timestamp\">\n                            12:40:18 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"station\" data-kid=\"1-1-3-2-6\" data-name=\"security review station card\">\n                    <div class=\"station-content\" data-kid=\"1-1-3-2-6-1\" data-name=\"station content container\">\n                        <div class=\"flex items-center gap-2 text-sm font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-2-6-1-1\" data-name=\"station header\">\n                            <span aria-hidden=\"true\" class=\"station-mark unavailable\" data-kid=\"1-1-3-2-6-1-1-1\" data-name=\"status mark\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-x text-[14px]\" data-kid=\"1-1-3-2-6-1-1-2\" data-name=\"shield icon\" style=\"width:14px;height:14px;color:var(--danger);display:inline-block\">\n                            </i>\n                            Security review\n                        </div>\n                        <p class=\"mono mt-3 text-[11px] text-[var(--danger)]\" data-kid=\"1-1-3-2-6-1-2\" data-name=\"station status label\">\n                            Unavailable\n                        </p>\n                        <p class=\"mt-1 max-w-[160px] text-xs leading-4 text-[var(--muted)]\" data-kid=\"1-1-3-2-6-1-3\" data-name=\"station details text\">\n                            Agent result not returned\n                        </p>\n                        <p class=\"mono mt-2 text-[10px] text-[var(--quiet)]\" data-kid=\"1-1-3-2-6-1-4\" data-name=\"station timestamp\">\n                            —\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"control-grid mt-7 grid grid-cols-[7fr_5fr] items-start gap-7\" data-kid=\"1-1-4\" data-name=\"control panel grid\">\n            <section aria-labelledby=\"queue-title\" data-kid=\"1-1-4-1\" data-name=\"work queue section\">\n                <div class=\"flex items-end justify-between gap-4 border-b border-[var(--rule)] pb-3\" data-kid=\"1-1-4-1-1\" data