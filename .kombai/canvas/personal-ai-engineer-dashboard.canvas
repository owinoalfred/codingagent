t-left\" data-kid=\"2-4-2-1\" data-name=\"Tasks archive table\">\n                <thead data-kid=\"2-4-2-1-1\" data-name=\"Archive table head\">\n                    <tr class=\"text-[11px] tracking-[0.12em] text-[#B9B0A5] font-alegreya\" data-kid=\"2-4-2-1-1-1\" data-name=\"Archive table header row\">\n                        <th class=\"w-[42%] px-4 pb-3 font-semibold\" data-kid=\"2-4-2-1-1-1-1\" data-name=\"Task column header\">\n                            Task\n                        </th>\n                        <th class=\"w-[17%] px-4 pb-3 font-semibold\" data-kid=\"2-4-2-1-1-1-2\" data-name=\"State column header\">\n                            State\n                        </th>\n                        <th class=\"w-[17%] px-4 pb-3 font-semibold\" data-kid=\"2-4-2-1-1-1-3\" data-name=\"Stage column header\">\n                            Latest stage\n                        </th>\n                        <th class=\"w-[14%] px-4 pb-3 font-semibold\" data-kid=\"2-4-2-1-1-1-4\" data-name=\"Created column header\">\n                            Created\n                        </th>\n                        <th class=\"w-[10%] px-4 pb-3 font-semibold\" data-kid=\"2-4-2-1-1-1-5\" data-name=\"ID column header\">\n                            ID\n                        </th>\n                    </tr>\n                </thead>\n                <tbody class=\"text-[13px]\" data-kid=\"2-4-2-1-2\" data-name=\"Archive table body\">\n                    <tr class=\"archive-row hoverable\" data-kid=\"2-4-2-1-2-1\" data-name=\"Task record row 1\">\n                        <td class=\"px-4 py-4 font-medium text-[#F1ECE3]\" data-kid=\"2-4-2-1-2-1-1\" data-name=\"Record title\">\n                            Refactor approval flow\n                        </td>\n                        <td class=\"px-4 py-4\" data-kid=\"2-4-2-1-2-1-2\" data-name=\"Record state cell\">\n                            <span class=\"flex items-center gap-2 text-[#D18A4B]\" data-kid=\"2-4-2-1-2-1-2-1\" data-name=\"Record status label\">\n                                <span class=\"status-square status-square-copper\" data-kid=\"2-4-2-1-2-1-2-1-1\" data-name=\"Status indicator square\">\n                                </span>\n                                Approval held\n                            </span>\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-1-3\" data-name=\"Latest stage\">\n                            Coder\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-1-4\" data-name=\"Created time\">\n                            12:03 UTC\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-1-5\" data-name=\"Task ID\">\n                            f9a2c7d1\n                        </td>\n                    </tr>\n                    <tr class=\"archive-row hoverable\" data-kid=\"2-4-2-1-2-2\" data-name=\"Task record row 2\">\n                        <td class=\"px-4 py-4 font-medium text-[#F1ECE3]\" data-kid=\"2-4-2-1-2-2-1\" data-name=\"Record title\">\n                            Run security audit\n                        </td>\n                        <td class=\"px-4 py-4\" data-kid=\"2-4-2-1-2-2-2\" data-name=\"Record state cell\">\n                            <span class=\"flex items-center gap-2 text-[#6EAA87]\" data-kid=\"2-4-2-1-2-2-2-1\" data-name=\"Record status label\">\n                                <span class=\"status-square status-square-green\" data-kid=\"2-4-2-1-2-2-2-1-1\" data-name=\"Status indicator square\">\n                                </span>\n                                Completed\n                            </span>\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-2-3\" data-name=\"Latest stage\">\n                            Security\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-2-4\" data-name=\"Created time\">\n                            11:37 UTC\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-2-5\" data-name=\"Task ID\">\n                            a42bf123\n                        </td>\n                    </tr>\n                    <tr class=\"archive-row hoverable\" data-kid=\"2-4-2-1-2-3\" data-name=\"Task record row 3\">\n                        <td class=\"px-4 py-4 font-medium text-[#F1ECE3]\" data-kid=\"2-4-2-1-2-3-1\" data-name=\"Record title\">\n                            Improve model routing\n                        </td>\n                        <td class=\"px-4 py-4\" data-kid=\"2-4-2-1-2-3-2\" data-name=\"Record state cell\">\n                            <span class=\"flex items-center gap-2 text-[#7394B5]\" data-kid=\"2-4-2-1-2-3-2-1\" data-name=\"Record status label\">\n                                <span class=\"status-square status-square-blue\" data-kid=\"2-4-2-1-2-3-2-1-1\" data-name=\"Status indicator square\">\n                                </span>\n                                In execution\n                            </span>\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-3-3\" data-name=\"Latest stage\">\n                            Tester\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-3-4\" data-name=\"Created time\">\n                            11:12 UTC\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-3-5\" data-name=\"Task ID\">\n                            8d0e4a2c\n                        </td>\n                    </tr>\n                    <tr class=\"archive-row hoverable\" data-kid=\"2-4-2-1-2-4\" data-name=\"Task record row 4\">\n                        <td class=\"px-4 py-4 font-medium text-[#F1ECE3]\" data-kid=\"2-4-2-1-2-4-1\" data-name=\"Record title\">\n                            Harden approval handling\n                        </td>\n                        <td class=\"px-4 py-4\" data-kid=\"2-4-2-1-2-4-2\" data-name=\"Record state cell\">\n                            <span class=\"flex items-center gap-2 text-[#BE625C]\" data-kid=\"2-4-2-1-2-4-2-1\" data-name=\"Record status label\">\n                                <span class=\"status-square status-square-garnet\" data-kid=\"2-4-2-1-2-4-2-1-1\" data-name=\"Status indicator square\">\n                                </span>\n                                Requires review\n                            </span>\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-4-3\" data-name=\"Latest stage\">\n                            Security\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-4-4\" data-name=\"Created time\">\n                            10:46 UTC\n                        </td>\n                        <td class=\"px-4 py-4 text-[#B9B0A5] font-technical\" data-kid=\"2-4-2-1-2-4-5\" data-name=\"Task ID\">\n                            6bc19e2a\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </section>\n    <footer class=\"mt-8 flex items-center justify-between border-t border-[#4B4640] pt-4 text-[11px] text-[#B9B0A5]\" data-kid=\"2-5\" data-name=\"Footer section\">\n        <span data-kid=\"2-5-1\" data-name=\"Footer branding text\">\n            Evidence-first observability · local task memory\n        </span>\n        <span class=\"font-technical\" data-kid=\"2-5-2\" data-name=\"Version path text\">\n            /v1/dashboard\n        </span>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-09-19T12:43:05.909386+00:00",
