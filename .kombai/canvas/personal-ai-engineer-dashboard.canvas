ass=\"text-[12px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-2-2-1-1\" data-name=\"endpoint label\">\n                                    Model endpoint\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-1-3-2-2-1-2\" data-name=\"endpoint meta\">\n                                    qwen3-coder-next\n                                </p>\n                            </div>\n                            <span class=\"flex items-center gap-2 text-[11px] text-[var(--green)]\" data-kid=\"2-1-2-1-3-2-2-2\" data-name=\"endpoint status indicator\">\n                                <span class=\"h-2 w-2 rounded-full bg-[var(--green)]\" data-kid=\"2-1-2-1-3-2-2-2-1\" data-name=\"endpoint status dot\">\n                                </span>\n                                reachable\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"2-1-2-1-3-2-3\" data-name=\"total tokens row\">\n                            <div data-kid=\"2-1-2-1-3-2-3-1\" data-name=\"total tokens name/meta\">\n                                <p class=\"text-[12px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-2-3-1-1\" data-name=\"total tokens label\">\n                                    Total tokens\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-1-3-2-3-1-2\" data-name=\"total tokens meta\">\n                                    prompt + completion\n                                </p>\n                            </div>\n                            <span class=\"mono text-[12px] text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-3-2-3-2\" data-name=\"total token count\" data-reason=\"count updated by script\">\n                                1,284,320\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"2-1-2-1-3-2-4\" data-name=\"aggregate cost row\">\n                            <div data-kid=\"2-1-2-1-3-2-4-1\" data-name=\"aggregate cost name/meta\">\n                                <p class=\"text-[12px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-2-4-1-1\" data-name=\"aggregate cost label\">\n                                    Aggregate cost\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-1-3-2-4-1-2\" data-name=\"aggregate cost meta\">\n                                    usage to date\n                                </p>\n                            </div>\n                            <span class=\"mono text-[12px] text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-3-2-4-2\" data-name=\"aggregate cost value\" data-reason=\"value updated by script\">\n                                $2.5686\n                            </span>\n                        </div>\n                        <div class=\"py-3\" data-kid=\"2-1-2-1-3-2-5\" data-name=\"active task spend row\">\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-2-1-3-2-5-1\" data-name=\"active task spend info\">\n                                <div data-kid=\"2-1-2-1-3-2-5-1-1\" data-name=\"active task label/meta\">\n                                    <p class=\"text-[12px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-2-5-1-1-1\" data-name=\"active task label\">\n                                        Active task spend\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-1-3-2-5-1-1-2\" data-name=\"active task name meta\">\n                                        Improve model routing\n                                    </p>\n                                </div>\n                                <span class=\"mono text-[12px] text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-3-2-5-1-2\" data-name=\"active task cost\" data-reason=\"cost value updated by script\">\n                                    $0.42 / $2.00\n                                </span>\n                            </div>\n                            <div class=\"meter-track mt-3\" data-kid=\"2-1-2-1-3-2-5-2\" data-name=\"meter track\">\n                                <div class=\"meter-fill w-[21%]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-3-2-5-2-1\" data-name=\"meter fill\" data-reason=\"width updated by script based on spend\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"2-1-2-1-3-2-6\" data-name=\"pending approvals row\">\n                            <div data-kid=\"2-1-2-1-3-2-6-1\" data-name=\"pending approvals info\">\n                                <p class=\"text-[12px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-2-6-1-1\" data-name=\"pending label\">\n                                    Pending approvals\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-1-3-2-6-1-2\" data-name=\"pending meta\">\n                                    human decisions\n                                </p>\n                            </div>\n                            <span class=\"mono text-[12px] text-[var(--amber)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-3-2-6-2\" data-name=\"pending status value\" data-reason=\"count updated by script\">\n                                1 waiting\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 border border-[var(--rule)] bg-[var(--surface)] p-3\" data-kid=\"2-1-2-1-3-3\" data-name=\"evidence policy note\">\n                        <p class=\"flex items-center gap-2 text-[11px] text-[var(--ink)]\" data-kid=\"2-1-2-1-3-3-1\" data-name=\"policy title\">\n                            <i class=\"ti ti-shield-check icon text-[14px] text-[var(--celadon)]\" data-kid=\"2-1-2-1-3-3-1-1\" data-name=\"shield icon\">\n                            </i>\n                            Evidence is explicit\n                        </p>\n                        <p class=\"mt-1 text-[10px] leading-5 text-[var(--muted)]\" data-kid=\"2-1-2-1-3-3-2\" data-name=\"policy description\">\n                            Unobserved sandbox and security states are shown as such, never inferred as healthy.\n                        </p>\n                    </div>\n                </aside>\n            </div>\n            <section class=\"ledger-order mt-8\" data-kid=\"2-1-2-2\" data-name=\"evidence ledger section\">\n                <div class=\"mb-3 flex items-end justify-between border-b border-[var(--rule)] pb-3\" data-kid=\"2-1-2-2-1\" data-name=\"ledger header\">\n                    <div data-kid=\"2-1-2-2-1-1\" data-name=\"ledger title block\">\n                        <p class=\"text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"ledger title\">\n                            Evidence ledger\n                        </p>\n                        <h2 class=\"mt-1 text-[17px] font-semibold tracking-[-0.025em]\" data-kid=\"2-1-2-2-1-1-2\" data-name=\"ledger headline\">\n                            Recent runs\n                        </h2>\n                    </div>\n                    <span class=\"mono text-[10px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-1-2\" data-name=\"ledger task count\" data-reason=\"count updated by script\">\n                        showing 4 of 24 tasks\n                    </span>\n                </div>\n                <div class=\"overflow-x-auto border-y border-[var(--rule)]\" data-kid=\"2-1-2-2-2\" data-name=\"ledger table container\">\n                    <table class=\"compact-table w-full min-w-[760px] border-collapse text-left\" data-kid=\"2-1-2-2-2-1\" data-name=\"recent runs table\">\n                        <thead data-kid=\"2-1-2-2-2-1-1\" data-name=\"table header\">\n                            <tr class=\"border-b border-[var(--rule)] text-[10px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-1-1\" data-name=\"header row\">\n                                <th class=\"py-3 pr-4 font-medium\" data-kid=\"2-1-2-2-2-1-1-1-1\" data-name=\"task column header\">\n                                    Task\n                                </th>\n                                <th class=\"py-3 pr-4 font-medium\" data-kid=\"2-1-2-2-2-1-1-1-2\" data-name=\"state column header\">\n                                    State\n                                </th>\n                                <th class=\"py-3 pr-4 font-medium\" data-kid=\"2-1-2-2-2-1-1-1-3\" data-name=\"stage column header\">\n                                    Latest stage\n                                </th>\n                                <th class=\"py-3 pr-4 font-medium\" data-kid=\"2-1-2-2-2-1-1-1-4\" data-name=\"created column header\">\n                                    Created\n                                </th>\n                                <th class=\"py-3 font-medium\" data-kid=\"2-1-2-2-2-1-1-1-5\" data-name=\"id column header\">\n                                    Task ID\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-[var(--rule)]\" data-kid=\"2-1-2-2-2-1-2\" data-name=\"table body\">\n                            <tr class=\"ledger-row\" data-kid=\"2-1-2-2-2-1-2-1\" data-name=\"table row 1\">\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-1-1\" data-name=\"task column\">\n                                    <p class=\"text-[12px] font-medium text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-1-1-1\" data-name=\"task name\">\n                                        Improve model routing\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-1-1-2\" data-name=\"task state detail\">\n                                        active execution\n                                    </p>\n                                </td>\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-1-2\" data-name=\"state column\">\n                                    <span class=\"flex items-center gap-2 text-[11px] text-[var(--blue)]\" data-kid=\"2-1-2-2-2-1-2-1-2-1\" data-name=\"state badge\">\n                                        <span class=\"h-2 w-2 bg-[var(--blue)]\" data-kid=\"2-1-2-2-2-1-2-1-2-1-1\" data-name=\"state dot\">\n                                        </span>\n                                        running\n                                    </span>\n                                </td>\n                                <td class=\"py-3 pr-4 text-[11px] text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-1-3\" data-name=\"stage column\">\n                                    Tester\n                                </td>\n                                <td class=\"py-3 pr-4 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-1-4\" data-name=\"created column\">\n                                    today · 11:12\n                                </td>\n                                <td class=\"py-3 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-1-5\" data-name=\"id column\">\n                                    8d0e4a2c\n                                </td>\n                            </tr>\n                            <tr class=\"ledger-row\" data-kid=\"2-1-2-2-2-1-2-2\" data-name=\"table row 2\">\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-2-1\" data-name=\"task column\">\n                                    <p class=\"text-[12px] font-medium text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-2-1-1\" data-name=\"task name\">\n                                        Refactor approval flow\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-2-1-2\" data-name=\"task state detail\">\n                                        human decision required\n                                    </p>\n                                </td>\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-2-2\" data-name=\"state column\">\n                                    <span class=\"flex items-center gap-2 text-[11px] text-[var(--amber)]\" data-kid=\"2-1-2-2-2-1-2-2-2-1\" data-name=\"state badge\">\n                                        <span class=\"h-2 w-2 bg-[var(--amber)]\" data-kid=\"2-1-2-2-2-1-2-2-2-1-1\" data-name=\"state dot\">\n                                        </span>\n                                        approval pending\n                                    </span>\n                                </td>\n                                <td class=\"py-3 pr-4 text-[11px] text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-2-3\" data-name=\"stage column\">\n                                    Coder\n                                </td>\n                                <td class=\"py-3 pr-4 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-2-4\" data-name=\"created column\">\n                                    today · 11:37\n                                </td>\n                                <td class=\"py-3 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-2-5\" data-name=\"id column\">\n                                    f9a2c7d1\n                                </td>\n                            </tr>\n                            <tr class=\"ledger-row\" data-kid=\"2-1-2-2-2-1-2-3\" data-name=\"table row 3\">\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-3-1\" data-name=\"task column\">\n                                    <p class=\"text-[12px] font-medium text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-3-1-1\" data-name=\"task name\">\n                                        Run security audit\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-3-1-2\" data-name=\"task state detail\">\n                                        review output available\n                                    </p>\n                                </td>\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-3-2\" data-name=\"state column\">\n                                    <span class=\"flex items-center gap-2 text-[11px] text-[var(--red)]\" data-kid=\"2-1-2-2-2-1-2-3-2-1\" data-name=\"state badge\">\n                                        <span class=\"h-2 w-2 bg-[var(--red)]\" data-kid=\"2-1-2-2-2-1-2-3-2-1-1\" data-name=\"state dot\">\n                                        </span>\n                                        review required\n                                    </span>\n                                </td>\n                                <td class=\"py-3 pr-4 text-[11px] text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-3-3\" data-name=\"stage column\">\n                                    Security\n                                </td>\n                                <td class=\"py-3 pr-4 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-3-4\" data-name=\"created column\">\n                                    today · 10:54\n                                </td>\n                                <td class=\"py-3 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-3-5\" data-name=\"id column\">\n                                    a42bf123\n                                </td>\n                            </tr>\n                            <tr class=\"ledger-row\" data-kid=\"2-1-2-2-2-1-2-4\" data-name=\"table row 4\">\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-4-1\" data-name=\"task column\">\n                                    <p class=\"text-[12px] font-medium text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-4-1-1\" data-name=\"task name\">\n                                        Add model cost ceiling\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-1-2\" data-name=\"task state detail\">\n                                        merged to agent branch\n                                    </p>\n                                </td>\n                                <td class=\"py-3 pr-4\" data-kid=\"2-1-2-2-2-1-2-4-2\" data-name=\"state column\">\n                                    <span class=\"flex items-center gap-2 text-[11px] text-[var(--green)]\" data-kid=\"2-1-2-2-2-1-2-4-2-1\" data-name=\"state badge\">\n                                        <span class=\"h-2 w-2 bg-[var(--green)]\" data-kid=\"2-1-2-2-2-1-2-4-2-1-1\" data-name=\"state dot\">\n                                        </span>\n                                        completed\n                                    </span>\n                                </td>\n                                <td class=\"py-3 pr-4 text-[11px] text-[var(--ink)]\" data-kid=\"2-1-2-2-2-1-2-4-3\" data-name=\"stage column\">\n                                    Reviewer\n                                </td>\n                                <td class=\"py-3 pr-4 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-4\" data-name=\"created column\">\n                                    yesterday · 16:20\n                                </td>\n                                <td class=\"py-3 mono text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-5\" data-name=\"id column\">\n                                    c6e91b0f\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"mt-4 flex flex-wrap items-center justify-between gap-3 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-3\" data-name=\"ledger footer\">\n                    <span data-kid=\"2-1-2-2-3-1\" data-name=\"ledger note\">\n                        Statuses are reported from task and agent-run records.\n                    </span>\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"2-1-2-2-3-2\" data-name=\"ledger refresh timestamp\" data-reason=\"text updated by script to reflect recent refresh\">\n                        last refreshed just now\n                    </span>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-09-19T12:43:07.195004+00:00",
      "modified": "2026-09-19T12:43:55.537630+00:00",
