    "var_fe40ab5688c8": {
      "type": "variant",
      "label": "Intervention Desk Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Recursive:wght@400;500;600;700&display=swap');\n  :root {\n    --ink: #F0F2EA;\n    --muted: #AAB5AD;\n    --canvas: #101514;\n    --surface: #18201F;\n    --raised: #202A28;\n    --rule: #35403D;\n    --green: #4FAE78;\n    --blue: #4B86C5;\n    --amber: #D79B38;\n    --red: #C45C52;\n    --celadon: #A4C9B4;\n  }\n  .app-shell { font-family: 'Recursive', ui-sans-serif, system-ui, sans-serif; }\n  .mono { font-family: 'Recursive', ui-monospace, SFMono-Regular, Menlo, monospace; font-variation-settings: 'MONO' 1; letter-spacing: -0.01em; }\n  .icon { display: inline-flex; width: 1em; height: 1em; align-items: center; justify-content: center; line-height: 1; }\n  .focus-ring:focus-visible { outline: 2px solid var(--celadon); outline-offset: 3px; }\n  .action-button:hover { filter: brightness(1.08); }\n  .quiet-button:hover { background: rgba(164, 201, 180, 0.08); color: var(--ink); }\n  .ledger-row:hover { background: rgba(164, 201, 180, 0.045); }\n  .approval-details summary { cursor: pointer; list-style: none; }\n  .approval-details summary::-webkit-details-marker { display: none; }\n  .approval-details summary:hover { color: var(--ink); }\n  .approval-details[open] .summary-chevron { transform: rotate(180deg); }\n  .runline-marker { position: relative; z-index: 1; display: flex; width: 18px; height: 18px; align-items: center; justify-content: center; border: 1px solid var(--rule); background: var(--surface); }\n  .runline-marker.complete { border-color: var(--green); background: var(--green); color: var(--canvas); }\n  .runline-marker.current { width: 20px; height: 20px; border: 2px solid var(--celadon); background: var(--surface); box-shadow: inset 0 0 0 4px var(--blue); }\n  .runline-marker.observed { border-color: var(--muted); background: var(--surface); }\n  .runline-marker.empty { border-color: #60706A; background: var(--surface); }\n  .meter-track { background: #2A3531; height: 4px; }\n  .meter-fill { background: var(--amber); height: 4px; }\n  @media (max-width: 900px) {\n    .desktop-grid { grid-template-columns: 1fr !important; }\n    .attention-order { order: 1; }\n    .execution-order { order: 2; }\n    .condition-order { order: 3; }\n    .ledger-order { order: 4; }\n  }\n  @media (max-width: 560px) {\n    .masthead { flex-direction: column; gap: 16px; }\n    .health-cluster { align-items: flex-start !important; flex-direction: column; }\n    .compact-table { min-width: 680px; }\n  }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"app-shell min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"2\" data-name=\"application shell container\">\n    <div class=\"mx-auto max-w-[1480px] px-6 py-5 sm:px-8 lg:px-10\" data-kid=\"2-1\" data-name=\"responsive layout wrapper\">\n        <header class=\"masthead flex items-start justify-between border-b border-[var(--rule)] pb-5\" data-kid=\"2-1-1\" data-name=\"masthead header container\">\n            <div class=\"flex items-start gap-4\" data-kid=\"2-1-1-1\" data-name=\"application identity and status container\">\n                <div aria-hidden=\"true\" class=\"mt-1 flex h-8 w-8 items-center justify-center border border-[var(--celadon)] text-[var(--celadon)]\" data-kid=\"2-1-1-1-1\" data-name=\"application icon container\">\n                    <i class=\"ti ti-terminal-2 icon text-[16px]\" data-kid=\"2-1-1-1-1-1\" data-name=\"terminal icon\">\n                    </i>\n                </div>\n                <div data-kid=\"2-1-1-1-2\" data-name=\"application title block\">\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"2-1-1-1-2-1\" data-name=\"application name and role row\">\n                        <h1 class=\"text-[21px] font-semibold tracking-[-0.035em] text-[var(--ink)]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"application title\">\n                            Personal AI Engineer\n                        </h1>\n                        <span class=\"text-[12px] text-[var(--muted)]\" data-kid=\"2-1-1-1-2-1-2\" data-name=\"application role\">\n                            operator view\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-1-1-1-2-2\" data-name=\"application description\">\n                        A quiet control plane for self-hosted coding runs.\n                    </p>\n                </div>\n            </div>\n            <div class=\"health-cluster flex items-center gap-5 pt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-1-1-2\" data-name=\"health cluster container\">\n                <span class=\"flex items-center gap-2\" data-kid=\"2-1-1-2-1\" data-name=\"gateway health indicator\">\n                    <span class=\"h-2 w-2 rounded-full bg-[var(--green)]\" data-kid=\"2-1-1-2-1-1\" data-name=\"gateway status dot\">\n                    </span>\n                    <span data-kid=\"2-1-1-2-1-2\" data-name=\"gateway reachable label\">\n                        <span class=\"text-[var(--ink)]\" data-kid=\"2-1-1-2-1-2-1\" data-name=\"gateway label\">\n                            Gateway\n                        </span>\n                        reachable\n                    </span>\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"2-1-1-2-2\" data-name=\"model endpoint health indicator\">\n                    <span class=\"h-2 w-2 rounded-full bg-[var(--green)]\" data-kid=\"2-1-1-2-2-1\" data-name=\"model endpoint status dot\">\n                    </span>\n                    <span data-kid=\"2-1-1-2-2-2\" data-name=\"model endpoint reachable label\">\n                        <span class=\"text-[var(--ink)]\" data-kid=\"2-1-1-2-2-2-1\" data-name=\"model endpoint label\">\n                            Model endpoint\n                        </span>\n                        reachable\n                    </span>\n                </span>\n                <span class=\"border-l border-[var(--rule)] pl-5 mono text-[11px]\" data-dynamic=\"true\" data-kid=\"2-1-1-2-3\" data-name=\"health check timestamp\" data-reason=\"text updated by script to reflect recent check\">\n                    checked just now\n                </span>\n            </div>\n        </header>\n        <main class=\"mt-6\" data-kid=\"2-1-2\" data-name=\"page content main area\">\n            <div class=\"desktop-grid grid grid-cols-12 items-start gap-4\" data-kid=\"2-1-2-1\" data-name=\"dashboard grid container\">\n                <aside class=\"attention-order col-span-12 lg:col-span-3\" data-kid=\"2-1-2-1-1\" data-name=\"attention rail section\">\n                    <div class=\"mb-3 flex items-end justify-between border-b border-[var(--rule)] pb-3\" data-kid=\"2-1-2-1-1-1\" data-name=\"attention rail header\">\n                        <div data-kid=\"2-1-2-1-1-1-1\" data-name=\"attention rail title\">\n                            <p class=\"text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--amber)]\" data-kid=\"2-1-2-1-1-1-1-1\" data-name=\"attention rail label\">\n                                Attention rail\n                            </p>\n                            <h2 class=\"mt-1 text-[17px] font-semibold tracking-[-0.025em]\" data-kid=\"2-1-2-1-1-1-1-2\" data-name=\"attention rail headline\">\n                                Needs a decision\n                                <span class=\"font-normal text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-1-1-1-2-1\" data-name=\"pending task count\" data-reason=\"count updated by script as tasks change\">\n                                    · 1\n                                </span>\n                            </h2>\n                        </div>\n                        <i aria-hidden=\"true\" class=\"ti ti-alert-triangle icon text-[17px] text-[var(--amber)]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"alert triangle icon\">\n                        </i>\n                    </div>\n                    <article class=\"border border-[var(--rule)] border-t-2 border-t-[var(--amber)] bg-[var(--raised)] p-4\" data-kid=\"2-1-2-1-1-2\" data-name=\"approval request card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-1-2-1-1-2-1\" data-name=\"approval card header\">\n                            <div data-kid=\"2-1-2-1-1-2-1-1\" data-name=\"approval request title\">\n                                <p class=\"text-[14px] font-semibold leading-5 text-[var(--ink)]\" data-kid=\"2-1-2-1-1-2-1-1-1\" data-name=\"approval task name\">\n                                    Refactor approval flow\n                                </p>\n                                <p class=\"mt-1 mono text-[11px] text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-1-1-2\" data-name=\"approval task ID and role\">\n                                    task f9a2c7d1 · coder\n                                </p>\n                            </div>\n                            <span class=\"shrink-0 border border-[var(--amber)]/60 px-2 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--amber)]\" data-kid=\"2-1-2-1-1-2-1-2\" data-name=\"approval status badge\">\n                                held\n                            </span>\n                        </div>\n                        <div class=\"mt-5 border-t border-[var(--rule)] pt-3\" data-kid=\"2-1-2-1-1-2-2\" data-name=\"approval details body\">\n                            <p class=\"text-[11px] uppercase tracking-[0.12em] text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-2-1\" data-name=\"approval request description label\">\n                                Approval request\n                            </p>\n                            <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-1-2-2-2\" data-name=\"approval action command container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-file-pencil icon text-[15px] text-[var(--amber)]\" data-kid=\"2-1-2-1-1-2-2-2-1\" data-name=\"file pencil icon\">\n                                </i>\n                                <span class=\"mono text-[13px] text-[var(--ink)]\" data-kid=\"2-1-2-1-1-2-2-2-2\" data-name=\"approval action command\">\n                                    write_file\n                                </span>\n                            </div>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-2-3\" data-name=\"approval task detail description\">\n                                Moderate review · changes a file in the isolated task worktree.\n                            </p>\n                        </div>\n                        <details class=\"approval-details mt-4 border-t border-[var(--rule)] pt-3\" data-kid=\"2-1-2-1-1-2-3\" data-name=\"approval tool arguments details\">\n                            <summary class=\"focus-ring flex items-center justify-between text-[11px] text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-3-1\" data-name=\"show tool arguments toggle\">\n                                <span data-kid=\"2-1-2-1-1-2-3-1-1\" data-name=\"toggle label\">\n                                    Show tool arguments\n                                </span>\n                                <i class=\"ti ti-chevron-down summary-chevron icon text-[14px] text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-3-1-2\" data-name=\"chevron icon\">\n                                </i>\n                            </summary>\n                            <div class=\"mt-3 border border-[var(--rule)] bg-[var(--surface)] p-3 mono text-[10px] leading-5 text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-3-2\" data-name=\"tool arguments content\">\n                                path: agent-api/app.py\n                                <br data-kid=\"2-1-2-1-1-2-3-2-1\" data-name=\"argument line break\"/>\n                                content: approval flow updates\n                                <br data-kid=\"2-1-2-1-1-2-3-2-2\" data-name=\"argument line break\"/>\n                                risk: moderate\n                            </div>\n                        </details>\n                        <div class=\"mt-5 flex gap-2\" data-kid=\"2-1-2-1-1-2-4\" data-name=\"approval action buttons container\">\n                            <button class=\"action-button focus-ring flex-1 bg-[var(--amber)] px-3 py-2.5 text-[12px] font-semibold text-[#171A16]\" data-kid=\"2-1-2-1-1-2-4-1\" data-name=\"approve button\" type=\"button\">\n                                Approve\n                            </button>\n                            <button class=\"quiet-button focus-ring border border-[var(--red)]/60 px-3 py-2.5 text-[12px] font-medium text-[var(--red)]\" data-kid=\"2-1-2-1-1-2-4-2\" data-name=\"reject button\" type=\"button\">\n                                Reject\n                            </button>\n                        </div>\n                        <p class=\"mt-3 flex items-center gap-2 text-[10px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-1-2-5\" data-name=\"approval wait timestamp\" data-reason=\"timestamp updated by script\">\n                            <i class=\"ti ti-clock icon text-[12px]\" data-kid=\"2-1-2-1-1-2-5-1\" data-name=\"clock icon\">\n                            </i>\n                            Waiting since 11:37 · approval ID\n                            <span class=\"mono\" data-kid=\"2-1-2-1-1-2-5-2\" data-name=\"approval ID code\">\n                                a42bf123\n                            </span>\n                        </p>\n                    </article>\n                    <div class=\"mt-3 border border-dashed border-[var(--rule)] px-4 py-4\" data-kid=\"2-1-2-1-1-3\" data-name=\"no decisions empty state\"