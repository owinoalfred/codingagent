# Personal AI Engineer Environment Configuration

# Model Endpoint (vLLM server running Qwen3-Coder-Next AWQ)
MODEL_ENDPOINT=http://localhost:8000/v1
MODEL_NAME=qwen3-coder-next

# Optional Cheap Tier Model Endpoint (for low-complexity tasks like docstrings and typos)
CHEAP_MODEL_ENDPOINT=http://localhost:8000/v1
CHEAP_MODEL_NAME=qwen2.5-coder-7b

# Task & Agent Constraints
MAX_TOOL_ITERATIONS=10
MAX_DEBUG_ATTEMPTS=5
PER_TASK_COST_CEILING_USD=2.00

# Directory & Database Settings
WORKSPACE_DIR=./workspace
DATABASE_PATH=agent_memory.db

# Docker Sandbox Execution (set to true to run commands inside docker container)
USE_DOCKER_SANDBOX=false
DOCKER_SANDBOX_IMAGE=python:3.12-slim
